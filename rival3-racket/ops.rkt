#lang racket/base

(require racket/match
         racket/dict)

(provide rival-functions
         rival-type
         rival-types)

(define rival-types '(bool real))

(define rival-functions ; keys: symbol; value: (cons otype itypes)
  #hash((PI . (real))
        (E . (real))
        (TRUE . (bool))
        (FALSE . (bool))
        (INFINITY . (real))
        (NAN . (real))
        (+ . (real real real))
        (- . (real real real))
        (* . (real real real))
        (/ . (real real real))
        (neg . (real real))
        (sqrt . (real real))
        (cbrt . (real real))
        (pow . (real real real))
        (pow2 . (real real))
        (exp . (real real))
        (exp2 . (real real))
        (expm1 . (real real))
        (log . (real real))
        (log2 . (real real))
        (log10 . (real real))
        (log1p . (real real))
        (logb . (real real))
        (sin . (real real))
        (cos . (real real))
        (tan . (real real))
        (asin . (real real))
        (acos . (real real))
        (atan . (real real))
        (atan2 . (real real real))
        (sinh . (real real))
        (cosh . (real real))
        (tanh . (real real))
        (asinh . (real real))
        (acosh . (real real))
        (atanh . (real real))
        (erf . (real real))
        (erfc . (real real))
        (lgamma . (real real))
        (tgamma . (real real))
        (rint . (real real))
        (round . (real real))
        (ceil . (real real))
        (floor . (real real))
        (trunc . (real real))
        (fmin . (real real real))
        (fmax . (real real real))
        (fdim . (real real real))
        (copysign . (real real real))
        (fmod . (real real real))
        (remainder . (real real real))
        (hypot . (real real real))
        (fma . (real real real real))
        (fabs . (real real))
        (not . (bool bool))
        (and . (bool bool bool))
        (or . (bool bool bool))
        (== . (bool real real))
        (!= . (bool real real))
        (< . (bool real real))
        (> . (bool real real))
        (<= . (bool real real))
        (>= . (bool real real))
        (assert . (bool bool))
        (error . (bool real))
        (if . (real bool real real))))

(define (rival-type expr env)
  (match expr
    [(? number?) 'real]
    [(or 'PI 'E 'INFINITY 'NAN) 'real]
    [(or 'TRUE 'FALSE) 'bool]
    [(? symbol?) (dict-ref env expr)]
    [(list 'if c t f)
     (define ct (rival-type c env))
     (define tt (rival-type t env))
     (define ft (rival-type f env))
     (and (equal? ct 'bool) (equal? tt ft) tt)]
    [(list 'error a)
     (define at (rival-type a env))
     (and at 'bool)]
    [(list op args ...)
     (match-define (cons otype itypes) (hash-ref rival-functions op (list #f)))
     (and (equal? (length itypes) (length args))
          (andmap equal? itypes (map (lambda (a) (rival-type a env)) args))
          otype)]
    [_ #f]))
